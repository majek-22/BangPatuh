    <!-- Category Explanations (Compliance Value Reinforcement) -->
    <string name="exp_bribery">Law No. 20/2001 on Corruption Eradication: Giving or receiving bribes/gratuities violates integrity and anti-corruption statutory provisions.</string>
    <string name="exp_fraud">Manipulating corporate records, forging signatures, or fictitious bookkeeping damages organizational truth and integrity.</string>
    <string name="exp_money_laundering">AML-CFT Regulations (Anti-Money Laundering &amp; Countering Financing of Terrorism): Structuring suspicious transactions to disguise illicit proceeds.</string>
    <string name="exp_data_breach">Law No. 27/2022 on Personal Data Protection: Unauthorized disclosure of confidential or personal data violates privacy laws.</string>
    <string name="exp_systemic_corruption">Deeply entrenched abuse of entrusted power threatens institutional integrity and creates severe corporate criminal liability.</string>
    <string name="exp_official_document">Authorized corporate records must be preserved and processed through designated compliance governance channels.</string>
    <string name="exp_verified_approval">Proper dual-control sign-offs and management approvals ensure accountability and checks across all business decisions.</string>
    <string name="exp_valid_partnership">Vetted third-party counterparties who pass rigorous anti-corruption due diligence are legitimate business partners.</string>
    <string name="exp_certification">Industry and regulatory certifications validate verified operational adherence to international safety and ethical benchmarks.</string>
    <string name="exp_verified_invoice">Accurate invoices matched to legitimate purchase orders safeguard financial integrity against fraudulent billing.</string>
    <string name="exp_shield">Proactive risk vigilance and internal controls act as a corporate shield against reputational damage and regulatory penalties.</string>
    <string name="exp_bonus_corruptor">Special Freeze Bonus! Freezes the game for 5 seconds: Slice freely as many times as you can to seize stolen funds and earn high bonus points!</string>
    <string name="exp_false_alarm">An unconfirmed security tip that turned out to be baseless. Acting hastily without verification wastes corporate resources.</string>
    <string name="exp_unverified_rumor">Office gossip lacking factual evidence. Professional compliance requires documented proof, not speculative hearsay.</string>
    <string name="exp_honest_mistake">An accidental clerical typo or formatting error. Human mistakes require guidance and coaching, not criminal sanction.</string>

